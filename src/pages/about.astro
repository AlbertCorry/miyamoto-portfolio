---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
	PERSON,
	IMAGES,
	SITE_DESCRIPTION,
	ABOUT,
	SKILL_GROUPS,
	EDUCATION,
	ACCOMPLISHMENTS,
} from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About — ${PERSON.name}`}
			description={SITE_DESCRIPTION}
			image={IMAGES.about}
		/>
	</head>
	<body>
		<Header />

		<main class="about-page">
			<div class="container">
				<span class="section-label">About</span>
				<h1>About {PERSON.name}</h1>

				<div class="about-page-grid">
					<div class="about-page-image">
						<img src={IMAGES.about} alt={`${PERSON.name} portrait`} />
					</div>
					<div class="about-page-content">
						<p class="role">{PERSON.title}</p>
						{ABOUT.map((paragraph) => <p>{paragraph}</p>)}

						<div class="education-inline">
							<h2>Education</h2>
							<p>
								<strong>{EDUCATION.degree}</strong><br />
								{EDUCATION.school} · {EDUCATION.period}
							</p>
						</div>

						<div class="skill-groups">
							{
								SKILL_GROUPS.map((group) => (
									<div class="skill-group">
										<h2>{group.label}</h2>
										<div class="skills-tags">
											{group.skills.map((skill) => (
												<span class="skill-tag">{skill}</span>
											))}
										</div>
									</div>
								))
							}
						</div>

						<div class="accomplishments-inline">
							<h2>Accomplishments</h2>
							<ul>
								{ACCOMPLISHMENTS.map((item) => <li>{item}</li>)}
							</ul>
						</div>

						<a href="/#contact" class="btn">Get in Touch</a>
					</div>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.about-page {
		padding: 8rem 0 var(--section-gap);
	}

	.about-page h1 {
		margin-bottom: 3rem;
	}

	.about-page-grid {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: 4rem;
		align-items: start;
	}

	.about-page-image {
		overflow: hidden;
		aspect-ratio: 4 / 5;
	}

	.about-page-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.role {
		font-family: var(--serif);
		font-size: 1.25rem;
		font-style: italic;
		color: var(--accent);
		margin-bottom: 1.5rem !important;
	}

	.about-page-content p {
		margin-bottom: 1.25rem;
	}

	.about-page-content h2 {
		font-family: var(--sans);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--accent);
		margin: 2rem 0 0.75rem;
	}

	.education-inline strong {
		color: var(--text);
		font-weight: 500;
	}

	.skill-groups {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.skills-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
	}

	.skill-tag {
		padding: 0.5rem 1rem;
		font-size: 0.8125rem;
		color: var(--text);
		background: var(--accent-soft);
		border: 1px solid rgba(201, 169, 110, 0.25);
	}

	.accomplishments-inline ul {
		margin: 0;
		padding-left: 1.25rem;
	}

	.accomplishments-inline li {
		color: var(--text-muted);
		margin-bottom: 0.625rem;
		font-size: 0.9375rem;
	}

	.about-page-content .btn {
		margin-top: 2rem;
	}

	@media (max-width: 768px) {
		.about-page-grid {
			grid-template-columns: 1fr;
		}

		.about-page-image {
			max-width: 20rem;
		}
	}
</style>
