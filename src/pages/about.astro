---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { PERSON, IMAGES, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About — ${PERSON.name}`}
			description={SITE_DESCRIPTION}
			image={IMAGES.about}
		/>
	</head>
	<body>
		<Header />

		<main class="about-page">
			<div class="container">
				<span class="section-label">About</span>
				<h1>About {PERSON.name}</h1>

				<div class="about-page-grid">
					<div class="about-page-image">
						<img src={IMAGES.about} alt={`${PERSON.name} portrait`} />
					</div>
					<div class="about-page-content">
						<p>
							I'm {PERSON.name}, a {PERSON.title.toLowerCase()} based in {PERSON.location}.
							I specialize in creating thoughtful digital experiences that blend clean
							design with solid engineering.
						</p>
						<p>
							My work spans brand identity, web development, and creative direction. I
							believe the best projects come from close collaboration and a shared
							commitment to craft.
						</p>
						<p>
							When I'm not designing or coding, you'll find me exploring new cities,
							capturing moments through photography, or refining my minimalist workspace.
						</p>
						<a href="/#contact" class="btn">Get in Touch</a>
					</div>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.about-page {
		padding: 8rem 0 var(--section-gap);
	}

	.about-page h1 {
		margin-bottom: 3rem;
	}

	.about-page-grid {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: 4rem;
		align-items: start;
	}

	.about-page-image {
		overflow: hidden;
		aspect-ratio: 4 / 5;
	}

	.about-page-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.about-page-content p {
		margin-bottom: 1.25rem;
	}

	.about-page-content .btn {
		margin-top: 1.5rem;
	}

	@media (max-width: 768px) {
		.about-page-grid {
			grid-template-columns: 1fr;
		}

		.about-page-image {
			max-width: 20rem;
		}
	}
</style>
