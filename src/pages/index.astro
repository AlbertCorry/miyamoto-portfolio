---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
	PERSON,
	IMAGES,
	SKILLS,
	EXPERIENCE,
} from '../consts';

const pageTitle = `${PERSON.name} — ${PERSON.title}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} image={IMAGES.hero} />
	</head>
	<body>
		<Header />

		<main>
			<!-- Hero -->
			<section class="hero">
				<div class="container hero-grid">
					<div class="hero-content">
						<span class="section-label">Portfolio</span>
						<h1>{PERSON.name}</h1>
						<p class="hero-title">{PERSON.title}</p>
						<p class="hero-tagline">{PERSON.tagline}</p>
						<div class="hero-actions">
							<a href="#gallery" class="btn">View My Work</a>
							<a href="#contact" class="btn btn-outline">Contact Me</a>
						</div>
					</div>
					<div class="hero-image">
						<div class="hero-image-frame">
							<img src={IMAGES.hero} alt={`${PERSON.name} professional portrait`} />
						</div>
						<div class="hero-accent"></div>
					</div>
				</div>
				<div class="hero-scroll">
					<span>Scroll</span>
					<div class="scroll-line"></div>
				</div>
			</section>

			<!-- About -->
			<section id="about" class="about section">
				<div class="container about-grid">
					<div class="about-image">
						<img src={IMAGES.about} alt={`${PERSON.name} portrait`} />
					</div>
					<div class="about-content">
						<span class="section-label">About Me</span>
						<h2>Crafting stories through design &amp; code</h2>
						<p>
							I'm a creative professional based in {PERSON.location}, passionate about
							building digital experiences that are both beautiful and functional. With a
							keen eye for detail and a love for minimalist aesthetics, I bring ideas to
							life across design and development.
						</p>
						<p>
							From brand identities to full-stack web applications, I approach every
							project with curiosity and precision — always striving to create work that
							resonates and endures.
						</p>
						<div class="skills-tags">
							{SKILLS.map((skill) => <span class="skill-tag">{skill}</span>)}
						</div>
					</div>
				</div>
			</section>

			<!-- Gallery -->
			<section id="gallery" class="gallery section">
				<div class="container">
					<div class="section-header">
						<span class="section-label">Selected Work</span>
						<h2>Visual Portfolio</h2>
						<p>A curated collection of moments, projects, and creative direction.</p>
					</div>
					<div class="gallery-grid">
						{
							IMAGES.gallery.map((item, i) => (
								<figure class={`gallery-item item-${i + 1}`}>
									<div class="gallery-image-wrap">
										<img src={item.src} alt={item.alt} loading="lazy" />
									</div>
									<figcaption>{item.caption}</figcaption>
								</figure>
							))
						}
					</div>
				</div>
			</section>

			<!-- Experience -->
			<section id="experience" class="experience section">
				<div class="container experience-grid">
					<div class="experience-intro">
						<span class="section-label">Experience</span>
						<h2>Where I've worked</h2>
						<p>
							A journey through studios, agencies, and independent projects — each
							shaping my approach to creative problem-solving.
						</p>
					</div>
					<div class="experience-list">
						{
							EXPERIENCE.map((job) => (
								<div class="experience-item">
									<div class="experience-period">{job.period}</div>
									<div class="experience-details">
										<h3>{job.role}</h3>
										<span>{job.company}</span>
									</div>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- Contact -->
			<section id="contact" class="contact section">
				<div class="container contact-inner">
					<span class="section-label">Get in Touch</span>
					<h2>Let's create something remarkable</h2>
					<p>
						Have a project in mind or just want to say hello? I'd love to hear from you.
					</p>
					<a href={`mailto:${PERSON.email}`} class="contact-email">{PERSON.email}</a>
					<div class="contact-actions">
						<a href={`mailto:${PERSON.email}`} class="btn">Send a Message</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		padding-top: 5rem;
	}

	.section {
		padding: var(--section-gap) 0;
	}

	/* Hero */
	.hero {
		min-height: calc(100vh - 5rem);
		display: flex;
		flex-direction: column;
		justify-content: center;
		position: relative;
		padding: 4rem 0;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
	}

	.hero-content {
		animation: fadeUp 0.8s ease both;
	}

	.hero-title {
		font-family: var(--serif);
		font-size: clamp(1.25rem, 2.5vw, 1.75rem);
		font-style: italic;
		color: var(--accent);
		margin: 0.5rem 0 1.5rem;
	}

	.hero-tagline {
		font-size: 1.0625rem;
		max-width: 42ch;
		margin-bottom: 2.5rem;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.hero-image {
		position: relative;
		animation: fadeUp 0.8s 0.15s ease both;
	}

	.hero-image-frame {
		position: relative;
		z-index: 1;
		overflow: hidden;
		aspect-ratio: 3 / 4;
		max-height: 70vh;
	}

	.hero-image-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		filter: grayscale(20%);
		transition: filter 0.4s ease;
	}

	.hero-image-frame:hover img {
		filter: grayscale(0%);
	}

	.hero-accent {
		position: absolute;
		bottom: -1.5rem;
		right: -1.5rem;
		width: 60%;
		height: 60%;
		border: 1px solid var(--accent);
		z-index: 0;
	}

	.hero-scroll {
		position: absolute;
		bottom: 2rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		color: var(--text-muted);
		font-size: 0.6875rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.scroll-line {
		width: 1px;
		height: 3rem;
		background: linear-gradient(to bottom, var(--accent), transparent);
		animation: scrollPulse 2s ease infinite;
	}

	/* About */
	.about {
		background: var(--bg-elevated);
	}

	.about-grid {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 5rem;
		align-items: center;
	}

	.about-image {
		overflow: hidden;
		aspect-ratio: 4 / 5;
	}

	.about-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}

	.about-content h2 {
		margin-bottom: 1.5rem;
	}

	.about-content p {
		margin-bottom: 1.25rem;
	}

	.skills-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		margin-top: 2rem;
	}

	.skill-tag {
		padding: 0.5rem 1rem;
		font-size: 0.8125rem;
		color: var(--text);
		background: var(--accent-soft);
		border: 1px solid rgba(201, 169, 110, 0.25);
	}

	/* Gallery */
	.section-header {
		margin-bottom: 3.5rem;
		max-width: 50ch;
	}

	.section-header h2 {
		margin-bottom: 1rem;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: 1.25rem;
	}

	.gallery-item {
		margin: 0;
	}

	.gallery-image-wrap {
		overflow: hidden;
		background: var(--bg-card);
	}

	.gallery-image-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.gallery-item:hover img {
		transform: scale(1.04);
	}

	.gallery-item figcaption {
		padding: 0.875rem 0 0;
		font-size: 0.8125rem;
		color: var(--text-muted);
		letter-spacing: 0.02em;
	}

	.item-1 {
		grid-column: span 7;
	}

	.item-1 .gallery-image-wrap {
		aspect-ratio: 16 / 10;
	}

	.item-2 {
		grid-column: span 5;
	}

	.item-2 .gallery-image-wrap {
		aspect-ratio: 4 / 5;
	}

	.item-3 {
		grid-column: span 4;
	}

	.item-3 .gallery-image-wrap {
		aspect-ratio: 3 / 4;
	}

	.item-4 {
		grid-column: span 4;
	}

	.item-4 .gallery-image-wrap {
		aspect-ratio: 3 / 4;
	}

	.item-5 {
		grid-column: span 4;
	}

	.item-5 .gallery-image-wrap {
		aspect-ratio: 3 / 4;
	}

	.item-6 {
		grid-column: span 12;
	}

	.item-6 .gallery-image-wrap {
		aspect-ratio: 21 / 7;
	}

	/* Experience */
	.experience-grid {
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: 4rem;
		align-items: start;
	}

	.experience-intro h2 {
		margin-bottom: 1rem;
	}

	.experience-list {
		display: flex;
		flex-direction: column;
	}

	.experience-item {
		display: grid;
		grid-template-columns: 8rem 1fr;
		gap: 2rem;
		padding: 2rem 0;
		border-bottom: 1px solid var(--border);
	}

	.experience-item:first-child {
		border-top: 1px solid var(--border);
	}

	.experience-period {
		font-size: 0.8125rem;
		color: var(--accent);
		letter-spacing: 0.05em;
		padding-top: 0.25rem;
	}

	.experience-details h3 {
		font-family: var(--sans);
		font-size: 1.125rem;
		font-weight: 500;
		color: var(--text);
		margin-bottom: 0.25rem;
	}

	.experience-details span {
		font-size: 0.9375rem;
		color: var(--text-muted);
	}

	/* Contact */
	.contact {
		background: var(--bg-elevated);
		text-align: center;
	}

	.contact-inner {
		max-width: 36rem;
	}

	.contact-inner h2 {
		margin-bottom: 1rem;
	}

	.contact-inner > p {
		margin-bottom: 2rem;
	}

	.contact-email {
		display: block;
		font-family: var(--serif);
		font-size: clamp(1.5rem, 4vw, 2.25rem);
		color: var(--accent);
		margin-bottom: 2.5rem;
		text-decoration: none;
	}

	.contact-email:hover {
		color: var(--text);
	}

	.contact-actions {
		display: flex;
		justify-content: center;
	}

	@keyframes fadeUp {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes scrollPulse {
		0%,
		100% {
			opacity: 0.3;
		}
		50% {
			opacity: 1;
		}
	}

	@media (max-width: 900px) {
		.hero-grid,
		.about-grid,
		.experience-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.hero-image {
			order: -1;
			max-width: 24rem;
			margin: 0 auto;
		}

		.hero-accent {
			display: none;
		}

		.gallery-grid {
			grid-template-columns: 1fr 1fr;
		}

		.item-1,
		.item-2,
		.item-3,
		.item-4,
		.item-5,
		.item-6 {
			grid-column: span 1;
		}

		.item-6 .gallery-image-wrap {
			aspect-ratio: 16 / 10;
		}

		.experience-item {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
	}

	@media (max-width: 540px) {
		.gallery-grid {
			grid-template-columns: 1fr;
		}

		.hero-scroll {
			display: none;
		}
	}
</style>
