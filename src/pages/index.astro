---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Avatar from '../components/Avatar.astro';
import Logo from '../components/Logo.astro';
import SectionIcon from '../components/SectionIcon.astro';
import {
	SITE_DESCRIPTION,
	PERSON,
	IMAGES,
	ABOUT,
	SKILL_GROUPS,
	EXPERIENCE,
	EDUCATION,
	ACCOMPLISHMENTS,
	FEATURED_PROJECT,
} from '../consts';

const pageTitle = `${PERSON.name} — ${PERSON.title}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} image={IMAGES.hero} />
	</head>
	<body>
		<Header />

		<main>
			<section class="hero">
				<div class="container hero-grid">
					<div class="hero-content">
						<span class="section-label">Portfolio</span>
						<h1>{PERSON.name}</h1>
						<p class="hero-title">{PERSON.title}</p>
						<p class="hero-tagline">{PERSON.tagline}</p>
						<div class="hero-actions">
							<a href="#projects" class="btn">View Projects</a>
							<a href="#contact" class="btn btn-outline">Contact Me</a>
						</div>
					</div>
					<div class="hero-image">
						<div class="hero-image-frame">
							<img src={IMAGES.hero} alt={`${PERSON.name} professional portrait`} />
						</div>
						<div class="hero-accent"></div>
					</div>
				</div>
				<div class="hero-scroll">
					<span>Scroll</span>
					<div class="scroll-line"></div>
				</div>
			</section>

			<section id="about" class="about section">
				<div class="container about-grid">
					<div class="about-image">
						<img src={IMAGES.about} alt={`${PERSON.name} portrait`} />
					</div>
					<div class="about-content">
						<span class="section-label">About Me</span>
						<h2>Building products that scale</h2>
						{ABOUT.map((paragraph) => <p>{paragraph}</p>)}
						<div class="skill-groups">
							{
								SKILL_GROUPS.map((group) => (
									<div class="skill-group">
										<div class="skill-group-header">
											<SectionIcon name={group.icon} size={18} />
											<h3>{group.label}</h3>
										</div>
										<div class="skills-tags">
											{group.skills.map((skill) => (
												<span class="skill-tag">{skill}</span>
											))}
										</div>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<section id="projects" class="project section">
				<div class="container">
					<div class="section-header project-header">
						<div class="project-header-top">
							<Avatar src={FEATURED_PROJECT.avatar} alt={FEATURED_PROJECT.title} size="lg" />
							<div>
								<span class="section-label">Featured Project</span>
								<h2>{FEATURED_PROJECT.title}</h2>
								<p class="project-meta">
									<SectionIcon name={FEATURED_PROJECT.icon} size={16} />
									{FEATURED_PROJECT.role} · {FEATURED_PROJECT.period}
								</p>
							</div>
						</div>
						<p>{FEATURED_PROJECT.summary}</p>
					</div>

					<div class="project-stats">
						{
							FEATURED_PROJECT.stats.map((stat) => (
								<div class="stat">
									<SectionIcon name={stat.icon} size={18} />
									<span class="stat-value">{stat.value}</span>
									<span class="stat-label">{stat.label}</span>
								</div>
							))
						}
					</div>

					<p class="project-overview">{FEATURED_PROJECT.overview}</p>

					<div class="challenge-solution">
						<div class="cs-block">
							<h3>The Challenge</h3>
							<ul>
								{FEATURED_PROJECT.challenge.map((item) => <li>{item}</li>)}
							</ul>
						</div>
						<div class="cs-block">
							<h3>The Solution</h3>
							<ul>
								{FEATURED_PROJECT.solution.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					</div>

					<div class="project-subsection">
						<h3>Technology Stack</h3>
						<div class="skills-tags">
							{FEATURED_PROJECT.techStack.map((tech) => <span class="skill-tag">{tech}</span>)}
						</div>
					</div>

					<div class="project-subsection">
						<h3>Business Modules</h3>
						<div class="module-grid">
							{FEATURED_PROJECT.modules.map((mod) => <span class="module-tag">{mod}</span>)}
						</div>
					</div>

					<div class="project-subsection">
						<h3>Technical Leadership</h3>
						<ul class="leadership-list">
							{FEATURED_PROJECT.leadership.map((item) => <li>{item}</li>)}
						</ul>
					</div>

					<div class="project-subsection">
						<h3>Business Impact</h3>
						<ul class="impact-list">
							{FEATURED_PROJECT.impact.map((item) => <li>{item}</li>)}
						</ul>
					</div>

					<div class="project-subsection">
						<h3>AI Roadmap — 2025 &amp; Beyond</h3>
						<div class="roadmap-grid">
							{
								FEATURED_PROJECT.aiRoadmap.map((item) => (
									<div class="roadmap-card">
										<div class="roadmap-card-header">
											<SectionIcon name={item.icon} size={18} />
											<h4>{item.title}</h4>
										</div>
										<p>{item.description}</p>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<section id="experience" class="experience section">
				<div class="container experience-grid">
					<div class="experience-intro">
						<span class="section-label">Experience</span>
						<h2>Professional background</h2>
						<p>
							From early-stage startups to enterprise digital transformation — leading
							product, engineering, and cross-functional teams to deliver production-grade
							software.
						</p>

						<div class="education-block">
							<div class="education-header">
								<Avatar src={EDUCATION.avatar} alt={EDUCATION.school} size="md" />
								<div>
									<span class="section-label">Education</span>
									<h3>{EDUCATION.degree}</h3>
									<p>
										<span class="education-school">
											<SectionIcon name={EDUCATION.icon} size={14} />
											{EDUCATION.school} · {EDUCATION.period}
										</span>
									</p>
								</div>
							</div>
						</div>
					</div>
					<div class="experience-list">
						{
							EXPERIENCE.map((job) => (
								<div class="experience-item">
									<Avatar src={job.avatar} alt={job.company} size="lg" />
									<div class="experience-details">
										<div class="experience-meta">
											<SectionIcon name={job.icon} size={16} />
											<span class="experience-period">{job.period}</span>
										</div>
										<h3>{job.role}</h3>
										<span class="company">{job.company}</span>
										<ul>
											{job.highlights.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									</div>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<section class="accomplishments section">
				<div class="container">
					<span class="section-label">Accomplishments</span>
					<h2>Impressive accomplishments</h2>
					<ul class="accomplishment-list">
						{
							ACCOMPLISHMENTS.map((item) => (
								<li>
									<SectionIcon name={item.icon} size={18} />
									<span>{item.text}</span>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<section id="contact" class="contact section">
				<div class="container contact-inner">
					<Logo size="lg" alt={PERSON.name} />
					<span class="section-label">Get in Touch</span>
					<h2>Let's build something meaningful</h2>
					<p>
						Interested in collaborating on enterprise software, SaaS products, or AI-powered
						solutions? I'd love to hear from you.
					</p>
					<a href={`mailto:${PERSON.email}`} class="contact-email">
						<SectionIcon name="mail" size={18} />
						{PERSON.email}
					</a>
					<p class="contact-detail contact-phone">
						<a href={`tel:${PERSON.phone.replace(/\s/g, '')}`}>
							<SectionIcon name="phone" size={16} />
							{PERSON.phone}
						</a>
					</p>
					<p class="contact-detail contact-address">{PERSON.location}</p>
					<div class="contact-actions">
						<a href={`mailto:${PERSON.email}`} class="btn">Send a Message</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		padding-top: 4.5rem;
	}

	.section {
		padding: var(--section-gap) 0;
	}

	.hero {
		min-height: calc(100vh - 4.5rem);
		display: flex;
		flex-direction: column;
		justify-content: center;
		position: relative;
		padding: 3rem 0;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3.5rem;
		align-items: center;
	}

	.hero-content {
		animation: fadeUp 1s var(--ease) both;
	}

	.hero-title {
		font-family: var(--serif);
		font-size: clamp(1.2rem, 2.5vw, 1.6rem);
		font-style: italic;
		font-weight: 400;
		color: var(--accent);
		margin: 0.75rem 0 1.25rem;
	}

	.hero-tagline {
		font-size: 1.0625rem;
		font-weight: 300;
		max-width: 44ch;
		margin-bottom: 2.25rem;
		line-height: 1.8;
	}

	.hero-actions {
		display: flex;
		gap: 0.875rem;
		flex-wrap: wrap;
	}

	.hero-image {
		position: relative;
		animation: fadeUp 1s 0.1s var(--ease) both;
	}

	.hero-image-frame {
		position: relative;
		z-index: 1;
		overflow: hidden;
		aspect-ratio: 3 / 4;
		max-height: 68vh;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-soft);
	}

	.hero-image-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		transition: transform 0.6s var(--ease);
	}

	.hero-image-frame:hover img {
		transform: scale(1.03);
	}

	.hero-accent {
		position: absolute;
		bottom: -1rem;
		right: -1rem;
		width: 55%;
		height: 55%;
		border-radius: var(--radius-lg);
		background: linear-gradient(135deg, rgba(212, 184, 150, 0.15), transparent);
		z-index: 0;
	}

	.hero-scroll {
		position: absolute;
		bottom: 2rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		color: var(--text-muted);
		font-size: 0.75rem;
		font-weight: 300;
	}

	.scroll-line {
		width: 1px;
		height: 2.5rem;
		background: linear-gradient(to bottom, var(--accent), transparent);
		border-radius: var(--radius-full);
		animation: scrollPulse 2.5s var(--ease) infinite;
	}

	.about {
		background: linear-gradient(180deg, transparent, var(--bg-elevated) 20%, var(--bg-elevated) 80%, transparent);
	}

	.about-grid {
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: 4rem;
		align-items: center;
	}

	.about-image {
		overflow: hidden;
		aspect-ratio: 4 / 5;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-soft);
	}

	.about-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		transition: transform 0.6s var(--ease);
	}

	.about-image:hover img {
		transform: scale(1.03);
	}

	.about-content h2 {
		margin-bottom: 1.25rem;
	}

	.about-content p {
		margin-bottom: 1.125rem;
		font-weight: 300;
	}

	.skill-groups {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-top: 1.75rem;
	}

	.skill-group h3 {
		font-family: var(--sans);
		font-size: 0.8125rem;
		font-weight: 400;
		letter-spacing: 0.03em;
		color: var(--accent);
		margin: 0;
	}

	.skill-group-header {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin-bottom: 0.625rem;
	}

	.skills-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.skill-tag {
		padding: 0.45rem 1rem;
		font-size: 0.8125rem;
		font-weight: 300;
		color: var(--text);
		background: var(--accent-soft);
		border: 1px solid rgba(212, 184, 150, 0.12);
		border-radius: var(--radius-full);
		transition: background 0.3s var(--ease);
	}

	.skill-tag:hover {
		background: rgba(212, 184, 150, 0.18);
	}

	.section-header {
		margin-bottom: 2.5rem;
		max-width: 65ch;
	}

	.section-header h2 {
		margin-bottom: 0.75rem;
	}

	.section-header p {
		font-weight: 300;
	}

	.project-header-top {
		display: flex;
		align-items: flex-start;
		gap: 1.25rem;
		margin-bottom: 1.25rem;
	}

	.project-meta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.9375rem;
		color: var(--accent);
		margin-bottom: 0 !important;
		margin-top: 0.5rem;
	}

	.project-stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		margin-bottom: 2.5rem;
	}

	.stat {
		padding: 1.75rem 1.5rem;
		text-align: center;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.stat:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow);
	}

	.stat-value {
		display: block;
		font-family: var(--serif);
		font-size: 2.75rem;
		color: var(--accent);
		line-height: 1;
		margin-bottom: 0.375rem;
	}

	.stat-label {
		font-size: 0.8125rem;
		font-weight: 300;
		color: var(--text-muted);
	}

	.project-overview {
		margin-bottom: 2.5rem;
		max-width: 70ch;
		font-weight: 300;
	}

	.challenge-solution {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
		margin-bottom: 2.5rem;
	}

	.cs-block {
		padding: 1.75rem;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		transition: box-shadow 0.3s var(--ease);
	}

	.cs-block:hover {
		box-shadow: var(--shadow);
	}

	.cs-block h3 {
		font-family: var(--sans);
		font-size: 0.9375rem;
		font-weight: 400;
		color: var(--accent);
		margin-bottom: 1rem;
	}

	.cs-block ul {
		margin: 0;
		padding-left: 1.125rem;
	}

	.cs-block li {
		color: var(--text-muted);
		margin-bottom: 0.5rem;
		font-size: 0.9375rem;
		font-weight: 300;
	}

	.project-subsection {
		margin-bottom: 2.5rem;
	}

	.project-subsection h3 {
		font-family: var(--sans);
		font-size: 0.9375rem;
		font-weight: 400;
		color: var(--accent);
		margin-bottom: 1rem;
	}

	.module-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
	}

	.module-tag {
		padding: 0.5rem 1.125rem;
		font-size: 0.875rem;
		font-weight: 300;
		color: var(--text);
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: var(--radius-full);
		transition: background 0.3s var(--ease);
	}

	.module-tag:hover {
		background: var(--accent-soft);
	}

	.leadership-list,
	.impact-list {
		margin: 0;
		padding-left: 1.125rem;
		max-width: 60ch;
	}

	.leadership-list li,
	.impact-list li {
		color: var(--text-muted);
		margin-bottom: 0.5rem;
		font-size: 0.9375rem;
		font-weight: 300;
	}

	.roadmap-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	.roadmap-card {
		padding: 1.5rem;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
	}

	.roadmap-card:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow);
	}

	.roadmap-card h4 {
		font-family: var(--sans);
		font-size: 0.9375rem;
		font-weight: 400;
		color: var(--text);
		margin: 0;
	}

	.roadmap-card-header {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin-bottom: 0.5rem;
	}

	.roadmap-card p {
		font-size: 0.875rem;
		font-weight: 300;
		margin: 0;
	}

	.experience-grid {
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: 3.5rem;
		align-items: start;
	}

	.experience-intro h2 {
		margin-bottom: 0.875rem;
	}

	.experience-intro > p {
		font-weight: 300;
	}

	.education-block {
		margin-top: 2.5rem;
		padding: 1.5rem;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
	}

	.education-header {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
	}

	.education-school {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.education-block h3 {
		font-family: var(--sans);
		font-size: 1rem;
		font-weight: 400;
		color: var(--text);
		margin: 0.5rem 0 0.25rem;
	}

	.education-block p {
		font-size: 0.9375rem;
		font-weight: 300;
	}

	.experience-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.experience-item {
		display: flex;
		gap: 1.25rem;
		padding: 1.75rem;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		transition: box-shadow 0.3s var(--ease), transform 0.3s var(--ease);
	}

	.experience-item:hover {
		box-shadow: var(--shadow);
		transform: translateY(-2px);
	}

	.experience-meta {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin-bottom: 0.5rem;
	}

	.experience-period {
		font-size: 0.8125rem;
		font-weight: 300;
		color: var(--accent);
	}

	.experience-details h3 {
		font-family: var(--sans);
		font-size: 1.0625rem;
		font-weight: 400;
		color: var(--text);
		margin-bottom: 0.25rem;
	}

	.experience-details .company {
		display: block;
		font-size: 0.9375rem;
		font-weight: 300;
		color: var(--text-muted);
		margin-bottom: 0.875rem;
	}

	.experience-details ul {
		margin: 0;
		padding-left: 1.125rem;
	}

	.experience-details li {
		color: var(--text-muted);
		font-size: 0.875rem;
		font-weight: 300;
		margin-bottom: 0.375rem;
	}

	.accomplishments {
		background: linear-gradient(180deg, transparent, var(--bg-elevated) 30%, var(--bg-elevated) 70%, transparent);
	}

	.accomplishments h2 {
		margin-bottom: 1.75rem;
	}

	.accomplishment-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	.accomplishment-list li {
		display: flex;
		align-items: flex-start;
		gap: 0.875rem;
		padding: 1.25rem 1.5rem;
		font-size: 0.9375rem;
		font-weight: 300;
		color: var(--text-muted);
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
	}

	.accomplishment-list li span {
		flex: 1;
	}

	.accomplishment-list li:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow);
	}

	.contact {
		text-align: center;
	}

	.contact-inner {
		max-width: 36rem;
		margin-inline: auto;
		padding: 3rem 2rem;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
	}

