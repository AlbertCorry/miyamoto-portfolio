---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
	SITE_DESCRIPTION,
	PERSON,
	IMAGES,
	ABOUT,
	SKILL_GROUPS,
	EXPERIENCE,
	EDUCATION,
	ACCOMPLISHMENTS,
	FEATURED_PROJECT,
} from '../consts';

const pageTitle = `${PERSON.name} — ${PERSON.title}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} image={IMAGES.hero} />
	</head>
	<body>
		<Header />

		<main>
			<section class="hero">
				<div class="container hero-grid">
					<div class="hero-content">
						<span class="section-label">Portfolio</span>
						<h1>{PERSON.name}</h1>
						<p class="hero-title">{PERSON.title}</p>
						<p class="hero-tagline">{PERSON.tagline}</p>
						<div class="hero-actions">
							<a href="#projects" class="btn">View Projects</a>
							<a href="#contact" class="btn btn-outline">Contact Me</a>
						</div>
					</div>
					<div class="hero-image">
						<div class="hero-image-frame">
							<img src={IMAGES.hero} alt={`${PERSON.name} professional portrait`} />
						</div>
						<div class="hero-accent"></div>
					</div>
				</div>
				<div class="hero-scroll">
					<span>Scroll</span>
					<div class="scroll-line"></div>
				</div>
			</section>

			<section id="about" class="about section">
				<div class="container about-grid">
					<div class="about-image">
						<img src={IMAGES.about} alt={`${PERSON.name} portrait`} />
					</div>
					<div class="about-content">
						<span class="section-label">About Me</span>
						<h2>Building products that scale</h2>
						{ABOUT.map((paragraph) => <p>{paragraph}</p>)}
						<div class="skill-groups">
							{
								SKILL_GROUPS.map((group) => (
									<div class="skill-group">
										<h3>{group.label}</h3>
										<div class="skills-tags">
											{group.skills.map((skill) => (
												<span class="skill-tag">{skill}</span>
											))}
										</div>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<section id="projects" class="project section">
				<div class="container">
					<div class="section-header">
						<span class="section-label">Featured Project</span>
						<h2>{FEATURED_PROJECT.title}</h2>
						<p class="project-meta">
							{FEATURED_PROJECT.role} · {FEATURED_PROJECT.period}
						</p>
						<p>{FEATURED_PROJECT.summary}</p>
					</div>

					<div class="project-stats">
						{
							FEATURED_PROJECT.stats.map((stat) => (
								<div class="stat">
									<span class="stat-value">{stat.value}</span>
									<span class="stat-label">{stat.label}</span>
								</div>
							))
						}
					</div>

					<p class="project-overview">{FEATURED_PROJECT.overview}</p>

					<div class="challenge-solution">
						<div class="cs-block">
							<h3>The Challenge</h3>
							<ul>
								{FEATURED_PROJECT.challenge.map((item) => <li>{item}</li>)}
							</ul>
						</div>
						<div class="cs-block">
							<h3>The Solution</h3>
							<ul>
								{FEATURED_PROJECT.solution.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					</div>

					<div class="project-subsection">
						<h3>Technology Stack</h3>
						<div class="skills-tags">
							{FEATURED_PROJECT.techStack.map((tech) => <span class="skill-tag">{tech}</span>)}
						</div>
					</div>

					<div class="project-subsection">
						<h3>Business Modules</h3>
						<div class="module-grid">
							{FEATURED_PROJECT.modules.map((mod) => <span class="module-tag">{mod}</span>)}
						</div>
					</div>

					<div class="project-subsection">
						<h3>Technical Leadership</h3>
						<ul class="leadership-list">
							{FEATURED_PROJECT.leadership.map((item) => <li>{item}</li>)}
						</ul>
					</div>

					<div class="project-subsection">
						<h3>Business Impact</h3>
						<ul class="impact-list">
							{FEATURED_PROJECT.impact.map((item) => <li>{item}</li>)}
						</ul>
					</div>

					<div class="project-subsection">
						<h3>AI Roadmap — 2025 &amp; Beyond</h3>
						<div class="roadmap-grid">
							{
								FEATURED_PROJECT.aiRoadmap.map((item) => (
									<div class="roadmap-card">
										<h4>{item.title}</h4>
										<p>{item.description}</p>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<section id="experience" class="experience section">
				<div class="container experience-grid">
					<div class="experience-intro">
						<span class="section-label">Experience</span>
						<h2>Professional background</h2>
						<p>
							From early-stage startups to enterprise digital transformation — leading
							product, engineering, and cross-functional teams to deliver production-grade
							software.
						</p>

						<div class="education-block">
							<span class="section-label">Education</span>
							<h3>{EDUCATION.degree}</h3>
							<p>
								{EDUCATION.school} · {EDUCATION.period}
							</p>
						</div>
					</div>
					<div class="experience-list">
						{
							EXPERIENCE.map((job) => (
								<div class="experience-item">
									<div class="experience-period">{job.period}</div>
									<div class="experience-details">
										<h3>{job.role}</h3>
										<span class="company">{job.company}</span>
										<ul>
											{job.highlights.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									</div>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<section class="accomplishments section">
				<div class="container">
					<span class="section-label">Accomplishments</span>
					<h2>Impressive accomplishments</h2>
					<ul class="accomplishment-list">
						{ACCOMPLISHMENTS.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</section>

			<section id="contact" class="contact section">
				<div class="container contact-inner">
					<span class="section-label">Get in Touch</span>
					<h2>Let's build something meaningful</h2>
					<p>
						Interested in collaborating on enterprise software, SaaS products, or AI-powered
						solutions? I'd love to hear from you.
					</p>
					<a href={`mailto:${PERSON.email}`} class="contact-email">{PERSON.email}</a>
					<p class="contact-detail">
						<a href={`tel:${PERSON.phone.replace(/\s/g, '')}`}>{PERSON.phone}</a>
					</p>
					<p class="contact-detail contact-address">{PERSON.location}</p>
					<div class="contact-actions">
						<a href={`mailto:${PERSON.email}`} class="btn">Send a Message</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		padding-top: 5rem;
	}

	.section {
		padding: var(--section-gap) 0;
	}

	.hero {
		min-height: calc(100vh - 5rem);
		display: flex;
		flex-direction: column;
		justify-content: center;
		position: relative;
		padding: 4rem 0;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
	}

	.hero-content {
		animation: fadeUp 0.8s ease both;
	}

	.hero-title {
		font-family: var(--serif);
		font-size: clamp(1.25rem, 2.5vw, 1.75rem);
		font-style: italic;
		color: var(--accent);
		margin: 0.5rem 0 1.5rem;
	}

	.hero-tagline {
		font-size: 1.0625rem;
		max-width: 42ch;
		margin-bottom: 2.5rem;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.hero-image {
		position: relative;
		animation: fadeUp 0.8s 0.15s ease both;
	}

	.hero-image-frame {
		position: relative;
		z-index: 1;
		overflow: hidden;
		aspect-ratio: 3 / 4;
		max-height: 70vh;
	}

	.hero-image-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		filter: grayscale(20%);
		transition: filter 0.4s ease;
	}

	.hero-image-frame:hover img {
		filter: grayscale(0%);
	}

	.hero-accent {
		position: absolute;
		bottom: -1.5rem;
		right: -1.5rem;
		width: 60%;
		height: 60%;
		border: 1px solid var(--accent);
		z-index: 0;
	}

	.hero-scroll {
		position: absolute;
		bottom: 2rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		color: var(--text-muted);
		font-size: 0.6875rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.scroll-line {
		width: 1px;
		height: 3rem;
		background: linear-gradient(to bottom, var(--accent), transparent);
		animation: scrollPulse 2s ease infinite;
	}

	.about {
		background: var(--bg-elevated);
	}

	.about-grid {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 5rem;
		align-items: center;
	}

	.about-image {
		overflow: hidden;
		aspect-ratio: 4 / 5;
	}

	.about-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}

	.about-content h2 {
		margin-bottom: 1.5rem;
	}

	.about-content p {
		margin-bottom: 1.25rem;
	}

	.skill-groups {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.skill-group h3 {
		font-family: var(--sans);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 0.75rem;
	}

	.skills-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
	}

	.skill-tag {
		padding: 0.5rem 1rem;
		font-size: 0.8125rem;
		color: var(--text);
		background: var(--accent-soft);
		border: 1px solid rgba(201, 169, 110, 0.25);
	}

	.section-header {
		margin-bottom: 3rem;
		max-width: 65ch;
	}

	.section-header h2 {
		margin-bottom: 0.75rem;
	}

	.project-meta {
		font-size: 0.9375rem;
		color: var(--accent);
		margin-bottom: 1.25rem !important;
	}

	.project-stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		margin-bottom: 3rem;
	}

	.stat {
		padding: 2rem;
		text-align: center;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
	}

	.stat-value {
		display: block;
		font-family: var(--serif);
		font-size: 3rem;
		color: var(--accent);
		line-height: 1;
		margin-bottom: 0.5rem;
	}

	.stat-label {
		font-size: 0.8125rem;
		color: var(--text-muted);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.project-overview {
		margin-bottom: 3rem;
		max-width: 70ch;
	}

	.challenge-solution {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		margin-bottom: 3rem;
	}

	.cs-block {
		padding: 2rem;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
	}

	.cs-block h3 {
		font-family: var(--sans);
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 1.25rem;
	}

	.cs-block ul {
		margin: 0;
		padding-left: 1.25rem;
	}

	.cs-block li {
		color: var(--text-muted);
		margin-bottom: 0.625rem;
		font-size: 0.9375rem;
	}

	.project-subsection {
		margin-bottom: 3rem;
	}

	.project-subsection h3 {
		font-family: var(--sans);
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 1.25rem;
	}

	.module-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.module-tag {
		padding: 0.625rem 1.25rem;
		font-size: 0.875rem;
		color: var(--text);
		background: var(--bg-card);
		border: 1px solid var(--border);
	}

	.leadership-list,
	.impact-list {
		margin: 0;
		padding-left: 1.25rem;
		max-width: 60ch;
	}

	.leadership-list li,
	.impact-list li {
		color: var(--text-muted);
		margin-bottom: 0.625rem;
		font-size: 0.9375rem;
	}

	.roadmap-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	.roadmap-card {
		padding: 1.5rem;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
	}

	.roadmap-card h4 {
		font-family: var(--sans);
		font-size: 1rem;
		font-weight: 500;
		color: var(--text);
		margin-bottom: 0.5rem;
	}

	.roadmap-card p {
		font-size: 0.875rem;
		margin: 0;
	}

	.experience-grid {
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: 4rem;
		align-items: start;
	}

	.experience-intro h2 {
		margin-bottom: 1rem;
	}

	.education-block {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}

	.education-block h3 {
		font-family: var(--sans);
		font-size: 1.0625rem;
		font-weight: 500;
		color: var(--text);
		margin: 0.75rem 0 0.25rem;
	}

	.education-block p {
		font-size: 0.9375rem;
	}

	.experience-list {
		display: flex;
		flex-direction: column;
	}

	.experience-item {
		display: grid;
		grid-template-columns: 8rem 1fr;
		gap: 2rem;
		padding: 2rem 0;
		border-bottom: 1px solid var(--border);
	}

	.experience-item:first-child {
		border-top: 1px solid var(--border);
	}

	.experience-period {
		font-size: 0.8125rem;
		color: var(--accent);
		letter-spacing: 0.05em;
		padding-top: 0.25rem;
	}

	.experience-details h3 {
		font-family: var(--sans);
		font-size: 1.125rem;
		font-weight: 500;
		color: var(--text);
		margin-bottom: 0.25rem;
	}

	.experience-details .company {
		display: block;
		font-size: 0.9375rem;
		color: var(--text-muted);
		margin-bottom: 1rem;
	}

	.experience-details ul {
		margin: 0;
		padding-left: 1.25rem;
	}

	.experience-details li {
		color: var(--text-muted);
		font-size: 0.875rem;
		margin-bottom: 0.5rem;
	}

	.accomplishments {
		background: var(--bg-elevated);
	}

	.accomplishments h2 {
		margin-bottom: 2rem;
	}

	.accomplishment-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	.accomplishment-list li {
		padding: 1.25rem 1.5rem;
		font-size: 0.9375rem;
		color: var(--text-muted);
		background: var(--bg-card);
		border-left: 2px solid var(--accent);
	}

	.contact {
		text-align: center;
	}

	.contact-inner {
		max-width: 36rem;
	}

	.contact-inner h2 {
		margin-bottom: 1rem;
	}

	.contact-inner > p {
		margin-bottom: 2rem;
	}

	.contact-email {
		display: block;
		font-family: var(--serif);
		font-size: clamp(1.5rem, 4vw, 2.25rem);
		color: var(--accent);
		margin-bottom: 1rem;
		text-decoration: none;
	}

	.contact-email:hover {
		color: var(--text);
	}

	.contact-detail {
		font-size: 0.9375rem;
		margin-bottom: 0.5rem !important;
	}

	.contact-detail a {
		color: var(--text-muted);
		text-decoration: none;
	}

	.contact-detail a:hover {
		color: var(--accent);
	}

	.contact-address {
		margin-bottom: 2rem !important;
	}

	.contact-actions {
		display: flex;
		justify-content: center;
	}

	@keyframes fadeUp {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes scrollPulse {
		0%,
		100% {
			opacity: 0.3;
		}
		50% {
			opacity: 1;
		}
	}

	@media (max-width: 900px) {
		.hero-grid,
		.about-grid,
		.experience-grid,
		.challenge-solution,
		.roadmap-grid {
			grid-template-columns: 1fr;
		}

		.hero-image {
			order: -1;
			max-width: 24rem;
			margin: 0 auto;
		}

		.hero-accent {
			display: none;
		}

		.project-stats {
			grid-template-columns: 1fr;
		}

		.accomplishment-list {
			grid-template-columns: 1fr;
		}

		.experience-item {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
	}

	@media (max-width: 540px) {
		.hero-scroll {
			display: none;
		}
	}
</style>
