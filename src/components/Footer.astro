---
import { PERSON, SOCIAL } from '../consts';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-inner">
		<div class="footer-brand">
			<Logo size="md" alt={PERSON.name} />
			<p>{PERSON.title}</p>
		</div>
		<div class="footer-links">
			<a href={`mailto:${PERSON.email}`}>{PERSON.email}</a>
			<a href={`tel:${PERSON.phone.replace(/\s/g, '')}`}>{PERSON.phone}</a>
			<a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
			<a href={SOCIAL.github} target="_blank" rel="noopener noreferrer">GitHub</a>
		</div>
	</div>
	<div class="container footer-copy">
		&copy; {year} {PERSON.name}. All rights reserved.
	</div>
</footer>

<style>
	.site-footer {
		padding: 4rem 0 2.5rem;
		border-top: 1px solid var(--border);
		background: linear-gradient(to bottom, transparent, var(--bg-elevated));
	}

	.footer-inner {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 3rem;
		padding-bottom: 2.5rem;
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
	}

	.footer-brand p {
		max-width: 28ch;
		font-size: 0.9375rem;
	}

	.footer-links {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
		text-align: right;
	}

	.footer-links a {
		font-size: 0.9375rem;
		font-weight: 300;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.3s var(--ease);
	}

	.footer-links a:hover {
		color: var(--accent);
	}

	.footer-copy {
		padding-top: 2rem;
		border-top: 1px solid var(--border);
		font-size: 0.8125rem;
		font-weight: 300;
		color: var(--text-muted);
	}

	@media (max-width: 640px) {
		.footer-inner {
			flex-direction: column;
		}

		.footer-links {
			text-align: left;
		}
	}
</style>
