---
interface Props {
	name: string;
	size?: number;
}

const { name, size = 20 } = Astro.props;

const icons: Record<string, string> = {
	briefcase:
		'<path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m-10 0h12a1 1 0 0 1 1 1v9a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V8a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 11h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
	building:
		'<path d="M4 20V6l8-3 8 3v14H4Z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/><path d="M9 20v-5h2v5M13 20v-3h2v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
	graduation:
		'<path d="M4 9.5 12 5l8 4.5-8 4.5-8-4.5Z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/><path d="M6 11.5V16l6 3 6-3v-4.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/><path d="M20 9.5V15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
	code: '<path d="M8 8 4 12l4 4M16 8l4 4-4 4M13 6l-2 12" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>',
	brain:
		'<path d="M12 4c-2 0-3.5 1.5-3.5 3.5 0 .8.3 1.5.8 2.1C8.3 10.5 7 12.2 7 14.2 7 17 9.2 19 12 19s5-2 5-4.8c0-2-.8-3.4-2-4.1.5-.6.8-1.3.8-2.1C15.5 5.5 14 4 12 4Z" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M12 4v15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
	globe:
		'<circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M4 12h16M12 4c2.5 2.8 2.5 14.2 0 16M12 4c-2.5 2.8-2.5 14.2 0 16" stroke="currentColor" stroke-width="1.5" fill="none"/>',
	rocket:
		'<path d="M12 4c3 2.5 5 6.5 5 11.5a5 5 0 0 1-10 0C7 10.5 9 6.5 12 4Z" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M10 18l-2 2M14 18l2 2M12 14v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
	users:
		'<path d="M8 18a4 4 0 1 0-3-6.5M16 18a4 4 0 1 1 3-6.5M10 10a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM14 10a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>',
	chart:
		'<path d="M5 19V9M10 19V5M15 19v-6M20 19V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M4 19h17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
	mail: '<rect x="4" y="6" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="m4 8 8 5 8-5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/>',
	phone:
		'<path d="M7 5h3l1.5 4-2 1.5a11 11 0 0 0 5 5L14 13l4 1.5V18a2 2 0 0 1-2 2A13 13 0 0 1 5 7a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/>',
	layers:
		'<path d="M12 4 4 8.5 12 13l8-4.5L12 4Z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/><path d="m4 12.5 8 4.5 8-4.5M4 16.5 12 21l8-4.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/>',
	github:
		'<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 18 4.77 5.07 5.07 0 0 0 17.91 1S16.73.65 13 2.48a13.38 13.38 0 0 0-7 0C2.27.65 1.09 1 1.09 1A5.07 5.07 0 0 0 1 4.77 5.44 5.44 0 0 0 3.5 8.55c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>',
	cpu:
		'<rect x="5" y="5" width="14" height="14" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
	database:
		'<ellipse cx="12" cy="6" rx="8" ry="3" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M4 6v6c0 1.66 3.58 3 8 3s8-1.34 8-3V6M4 12v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6" stroke="currentColor" stroke-width="1.5" fill="none"/>',
	sparkles:
		'<path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>',
};

const path = icons[name] ?? icons.sparkles;
---

<span class="section-icon" style={`--icon-size: ${size}px`}>
	<svg
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		width={size}
		height={size}
		aria-hidden="true"
		set:html={path}
	/>
</span>

<style>
	.section-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: calc(var(--icon-size) + 14px);
		height: calc(var(--icon-size) + 14px);
		border-radius: 50%;
		background: var(--accent-soft);
		color: var(--accent);
		flex-shrink: 0;
	}
</style>
